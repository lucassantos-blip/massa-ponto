{
  "name": "massa-ponto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "predev": "node scripts/icons.mjs",
    "prebuild": "node scripts/icons.mjs",
    "android:prepare": "npm run build && node scripts/prepare-android.mjs",
    "android:open": "npx cap open android",
    "ios:prepare": "npm run build && npx cap add ios && npx cap sync ios"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0"
  },
  "devDependencies": {
    "vite": "6.4.1",
    "typescript": "5.8.3",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@capacitor/cli": "^7.0.0"
  }
}
